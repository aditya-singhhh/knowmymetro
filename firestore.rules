rules_version = '2';
// KnowMyMetro security rules.
// Riders are signed in anonymously. Each rider owns only their own data.
// Crowd statistics, interchange data and tuning are server-only: they are the app's advantage.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    // profile, saved trips, push tokens
    match /users/{uid} {
      allow read, write: if isOwner(uid);
      match /{sub=**} { allow read, write: if isOwner(uid); }
    }

    // one-tap crowd report: create only, one per rider per train per day (id = uid_date_train)
    match /reports/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && id.matches(request.auth.uid + '_[0-9]{8}_.+')
        && request.resource.data.keys().hasOnly(['uid', 'service', 'origin', 'start', 'board', 'level', 'createdAt'])
        && request.resource.data.level in [0, 1, 2]
        && request.resource.data.board is string && request.resource.data.board.size() <= 5
        && request.resource.data.createdAt == request.time;
    }

    // "I know this change": coach and minutes for an interchange
    match /interchangeReports/{id} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'key', 'coach', 'minutes', 'createdAt'])
        && (request.resource.data.coach == null || request.resource.data.coach in ['front', 'middle', 'rear'])
        && request.resource.data.minutes is number && request.resource.data.minutes > 0 && request.resource.data.minutes < 20
        && request.resource.data.createdAt == request.time;
    }

    // trip recorder (founding riders): create-only, owner's id in the document id and fields
    match /recordings/{id} {
      // create, or overwrite your own (a retry after an upload broke halfway)
      allow create, update: if signedIn()
        && id.matches(request.auth.uid + '_[0-9]+')
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'startedAt', 'endedAt', 'platform', 'samples', 'chunks', 'kinds', 'stopReason', 'trip', 'createdAt'])
        && request.resource.data.createdAt == request.time;
      match /chunks/{n} {
        allow create, update: if signedIn()
          && id.matches(request.auth.uid + '_[0-9]+')
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'n', 'samples']);
      }
    }

    // public, read-only for the app
    // live delays riders measure on a train (see app/src/core/live.ts); anyone signed in may read
    match /trainLive/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && id.matches('[0-9]{8}_[A-Z]+_[0-9]+')
        && request.resource.data.keys().hasOnly(['line', 'delay', 'at', 'uid', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.delay is int && request.resource.data.delay > -1800 && request.resource.data.delay < 3600
        && request.resource.data.at is int
        && request.resource.data.updatedAt == request.time;
      // delay history: append-only, one entry per rider per reading
      match /log/{entry} {
        allow create: if signedIn()
          && entry.matches(request.auth.uid + '_[0-9]+')
          && request.resource.data.keys().hasOnly(['delay', 'at', 'uid', 'updatedAt'])
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.delay is int && request.resource.data.delay > -1800 && request.resource.data.delay < 3600
          && request.resource.data.updatedAt == request.time;
      }
    }
    match /timetable/{doc} { allow read: if true; }
    match /disruptions/{doc} { allow read: if signedIn(); }

    // everything else (crowdStats, interchanges, config) is server-only
    match /{document=**} { allow read, write: if false; }
  }
}
